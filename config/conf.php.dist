// $conf['images']['type'] = 'File';
// $conf['images']['params']['vfsroot'] = '/tmp';
$conf['images']['type'] = 'horde';
// If should images be viewed directly out of the VFS, specify the alias pointing to the right place on your filesystem ...
$conf['images']['direct'] = '/folks-images';
// What format should images be generated in? Make sure that your server supports whichever format you choose! ('jpeg' = JPEG, 'png' = PNG)
$conf['images']['image_type'] = 'png';
// Thumbnail width
$conf['images']['thumbnail_width'] = 80;
// Thumbnail height
$conf['images']['thumbnail_height'] = 80;
// Screen width
$conf['images']['screen_width'] = 300;
// Screen height
$conf['images']['screen_height'] = 300;

// ----------------------------------------------------------------------
// Online users
// ----------------------------------------------------------------------
// How long (in seconds) should we cache the user list?
$conf['online']['ttl'] = 300;
// Auto update users' last-click time?
$conf['online']['autoupdate'] = false;
// Use the application internally (rather than Cron) to delete users?
$conf['online']['autodelete'] = true;

// ----------------------------------------------------------------------
// Services
// ----------------------------------------------------------------------
// Is Cron set to update user counts? Content will not be counted during page loads.
$conf['services']['countcron'] = false;
// Select applications that should be ignored in services
$conf['services']['ignore'] = array();

// ----------------------------------------------------------------------
// Comments
// ----------------------------------------------------------------------
// Can users comment on news stories? ('authenticated' = Authenticated users, 'never' = No one, 'all' = All)
$conf['comments']['allow'] = 'authenticated';
