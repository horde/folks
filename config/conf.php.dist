$conf['storage']['params']['search'] = 'folks_search';
// Database activity table
$conf['storage']['params']['activity'] = 'folks_activity';

// ----------------------------------------------------------------------
// General
// ----------------------------------------------------------------------
// Email from which support messages will be sent
$conf['support'] = 'support@example.com';
// Driver for friends storage ('prefs' = Prefs - friends and blacklist only sored, 'sql' = SQL - friends and blacklist only, 'shared' = Shared - custom shared groups lists, 'facebook' = FaceBook, 'application' = Application)
